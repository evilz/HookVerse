{
  "// NOTE": "This is a template for User Secrets configuration for local development",
  "// USAGE": "Copy values to actual User Secrets using: dotnet user-secrets set 'Key' 'Value' --project src/HookVerse.AppHost",
  "// INITIALIZE": "First run: dotnet user-secrets init --project src/HookVerse.AppHost",
  
  "// External API Keys": "DO NOT COMMIT - Use User Secrets instead",
  "Datadog": {
    "ApiKey": "your-datadog-api-key-here",
    "AppKey": "your-datadog-app-key-here"
  },
  
  "ApplicationInsights": {
    "ConnectionString": "InstrumentationKey=your-key;IngestionEndpoint=https://region.in.applicationinsights.azure.com/"
  },
  
  "Smtp": {
    "Host": "smtp.example.com",
    "Port": "587",
    "Username": "noreply@hookverse.com",
    "Password": "your-smtp-password"
  },
  
  "ExternalServices": {
    "SlackWebhookUrl": "https://hooks.slack.com/services/YOUR/WEBHOOK/URL",
    "StripeWebhookSecret": "whsec_your_stripe_webhook_secret"
  },
  
  "// Production Connection Strings": "For testing Azure services locally",
  "ConnectionStrings": {
    "AzureSqlDatabase": "Server=tcp:your-server.database.windows.net,1433;Database=hookverse;User ID=admin;Password=your-password;Encrypt=True;",
    "AzureServiceBus": "Endpoint=sb://your-namespace.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=your-key",
    "AzureRedisCache": "your-cache.redis.cache.windows.net:6380,password=your-access-key,ssl=True,abortConnect=False"
  },
  
  "// Azure Key Vault": "For accessing production secrets in staging",
  "KeyVault": {
    "VaultUri": "https://your-keyvault.vault.azure.net/",
    "TenantId": "your-azure-tenant-id",
    "ClientId": "your-service-principal-client-id",
    "ClientSecret": "your-service-principal-secret"
  },
  
  "// Example Usage": "COMMANDS",
  "// Set Datadog API Key": "dotnet user-secrets set 'Datadog:ApiKey' 'dd123456789' --project src/HookVerse.AppHost",
  "// Set SMTP Password": "dotnet user-secrets set 'Smtp:Password' 'MySecurePass123!' --project src/HookVerse.AppHost",
  "// List all secrets": "dotnet user-secrets list --project src/HookVerse.AppHost",
  "// Remove a secret": "dotnet user-secrets remove 'Datadog:ApiKey' --project src/HookVerse.AppHost",
  "// Clear all secrets": "dotnet user-secrets clear --project src/HookVerse.AppHost",
  
  "// Security Notes": "IMPORTANT",
  "// 1": "Never commit actual secrets to version control",
  "// 2": "User Secrets are stored in: %APPDATA%/Microsoft/UserSecrets/<UserSecretsId>/secrets.json (Windows)",
  "// 3": "User Secrets are stored in: ~/.microsoft/usersecrets/<UserSecretsId>/secrets.json (Linux/macOS)",
  "// 4": "User Secrets are only for local development - use Azure Key Vault in production",
  "// 5": "Secrets set via dotnet user-secrets are automatically loaded by Aspire AppHost in Development environment",
  "// 6": "Access secrets in code via: builder.Configuration[\"Datadog:ApiKey\"]"
}
