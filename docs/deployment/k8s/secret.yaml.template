---
# HookVerse Secrets Template
# WARNING: This is a template file with placeholder values
# DO NOT commit actual secrets to version control
# Create the actual secret using kubectl or a secret management tool
#
# Usage:
#   1. Copy this file to secret.local.yaml (git-ignored)
#   2. Replace placeholder values with actual base64-encoded secrets
#   3. Apply: kubectl apply -f secret.local.yaml
#
# To encode a value:
#   echo -n "your-secret-value" | base64
#
# To decode a value:
#   echo "base64-encoded-value" | base64 -d
#
apiVersion: v1
kind: Secret
metadata:
  name: hookverse-secrets
  namespace: hookverse
  labels:
    app: hookverse
type: Opaque
data:
  # Database Connection String
  # Example PostgreSQL: "Host=postgres.hookverse.svc.cluster.local;Port=5432;Database=hookverse;Username=hookverse_user;Password=YourPassword123!"
  # Base64 encode the entire connection string
  database-connection-string: "REPLACE_WITH_BASE64_ENCODED_CONNECTION_STRING"
  
  # Message Bus Credentials
  # RabbitMQ username (e.g., "hookverse_user")
  rabbitmq-username: "REPLACE_WITH_BASE64_ENCODED_USERNAME"
  
  # RabbitMQ password
  rabbitmq-password: "REPLACE_WITH_BASE64_ENCODED_PASSWORD"
  
  # Kafka credentials (if using Kafka instead of RabbitMQ)
  kafka-username: "REPLACE_WITH_BASE64_ENCODED_USERNAME"
  kafka-password: "REPLACE_WITH_BASE64_ENCODED_PASSWORD"
  kafka-sasl-mechanism: "REPLACE_WITH_BASE64_ENCODED_SASL_MECHANISM"  # e.g., "PLAIN", "SCRAM-SHA-256"
  
  # AWS SQS credentials (if using SQS)
  aws-access-key-id: "REPLACE_WITH_BASE64_ENCODED_ACCESS_KEY"
  aws-secret-access-key: "REPLACE_WITH_BASE64_ENCODED_SECRET_KEY"
  aws-region: "REPLACE_WITH_BASE64_ENCODED_REGION"  # e.g., "us-east-1"
  
  # Encryption Keys
  # Generate with: openssl rand -base64 32
  payload-encryption-key: "REPLACE_WITH_BASE64_ENCODED_ENCRYPTION_KEY"
  secret-encryption-key: "REPLACE_WITH_BASE64_ENCODED_ENCRYPTION_KEY"
  
  # HMAC Signing Key
  # Generate with: openssl rand -base64 32
  hmac-signing-key: "REPLACE_WITH_BASE64_ENCODED_SIGNING_KEY"
  
  # Redis Password (if Redis is enabled)
  redis-password: "REPLACE_WITH_BASE64_ENCODED_PASSWORD"
  
  # OpenTelemetry Auth (if required)
  otel-api-key: "REPLACE_WITH_BASE64_ENCODED_API_KEY"
  
  # External Service API Keys (if needed)
  external-api-key: "REPLACE_WITH_BASE64_ENCODED_API_KEY"
---
# Example: Generate secrets from literals (for development only)
# Run this command to create the secret in your cluster:
#
# kubectl create secret generic hookverse-secrets \
#   --namespace=hookverse \
#   --from-literal=database-connection-string='Host=postgres;Port=5432;Database=hookverse;Username=user;Password=pass' \
#   --from-literal=rabbitmq-username='guest' \
#   --from-literal=rabbitmq-password='guest' \
#   --from-literal=payload-encryption-key='your-32-byte-key-here-base64' \
#   --from-literal=secret-encryption-key='your-32-byte-key-here-base64' \
#   --from-literal=hmac-signing-key='your-32-byte-key-here-base64' \
#   --dry-run=client -o yaml | kubectl apply -f -
#
---
