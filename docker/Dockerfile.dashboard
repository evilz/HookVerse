# Build stage
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Copy solution and project files
COPY HookVerse.sln ./
COPY src/HookVerse.Dashboard/HookVerse.Dashboard.csproj ./src/HookVerse.Dashboard/
COPY src/HookVerse.Shared/HookVerse.Shared.csproj ./src/HookVerse.Shared/

# Restore dependencies
RUN dotnet restore src/HookVerse.Dashboard/HookVerse.Dashboard.csproj

# Copy source code
COPY src/HookVerse.Dashboard/ ./src/HookVerse.Dashboard/
COPY src/HookVerse.Shared/ ./src/HookVerse.Shared/

# Build and publish
WORKDIR /src/src/HookVerse.Dashboard
RUN dotnet publish -c Release -o /app/publish --no-restore

# Runtime stage
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app

# Create non-root user
RUN adduser --disabled-password --gecos '' appuser && chown -R appuser /app
USER appuser

COPY --from=build /app/publish .

EXPOSE 8080
ENTRYPOINT ["dotnet", "HookVerse.Dashboard.dll"]
