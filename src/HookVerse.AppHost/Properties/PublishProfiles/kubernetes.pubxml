<?xml version="1.0" encoding="utf-8"?>
<!--
  Kubernetes Publish Profile for HookVerse AppHost
  Generates Kubernetes YAML manifests for deployment to K8s clusters
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>manifest</PublishProtocol>
    <ManifestType>k8s</ManifestType>
    <ManifestPublishPath>$(MSBuildProjectDirectory)\..\..\..\..\aspire\manifests\kubernetes\</ManifestPublishPath>
  </PropertyGroup>
</Project>
