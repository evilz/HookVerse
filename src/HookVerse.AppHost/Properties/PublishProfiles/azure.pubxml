<?xml version="1.0" encoding="utf-8"?>
<!--
  Azure Publish Profile for HookVerse AppHost
  Generates Azure Bicep templates for deployment to Azure Container Apps
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>manifest</PublishProtocol>
    <ManifestType>bicep</ManifestType>
    <ManifestPublishPath>$(MSBuildProjectDirectory)\..\..\..\..\aspire\manifests\azure\</ManifestPublishPath>
  </PropertyGroup>
</Project>
