    private string GetStatusClass(string color)
    {
        return color switch
        {
            "green" => "bg-success-subtle text-success",
            "blue" => "bg-primary-subtle text-primary",
            "red" => "bg-danger-subtle text-danger",
            "orange" => "bg-warning-subtle text-warning",
            _ => "bg-secondary-subtle text-secondary"
        };
    }

    private string GetStatusDotClass(string color)
    {
        return color;
    }

    private string GetTagClass(string color)
    {
        return color;
    }

    private Microsoft.AspNetCore.Components.RenderFragment GetActivityIcon(string type)
    {
        return type switch
        {
            "tag_added" => builder =>
            {
                builder.OpenElement(0, "i");
                builder.AddAttribute(1, "class", "bi bi-tag text-muted");
                builder.CloseElement();
            },
            "file_added" => builder =>
            {
                builder.OpenElement(0, "i");
                builder.AddAttribute(1, "class", "bi bi-file-text text-muted");
                builder.CloseElement();
            },
            "comment" or "mention" => builder =>
            {
                builder.OpenElement(0, "i");
                builder.AddAttribute(1, "class", "bi bi-chat text-muted");
                builder.CloseElement();
            },
            "assignment" => builder =>
            {
                builder.OpenElement(0, "i");
                builder.AddAttribute(1, "class", "bi bi-person text-muted");
                builder.CloseElement();
            },
            _ => builder => { }
        };
    }
