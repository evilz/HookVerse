@page "/post"
@rendermode InteractiveServer
@using HookVerse.Dashboard.Models

<PageTitle>Activity Log - HookVerse</PageTitle>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-md-12">
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h3 mb-0">Activity log</h1>
                <div class="d-flex align-items-center gap-3">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="showMentionedOnly" @bind="showMentionedOnly">
                        <label class="form-check-label text-muted small" for="showMentionedOnly">
                            Show mentioned only
                        </label>
                    </div>
                    <button class="btn btn-sm btn-outline-secondary" type="button">
                        <i class="bi bi-funnel"></i>
                    </button>
                </div>
            </div>

            <!-- Activity Timeline -->
            <div class="activity-timeline">
                @{
                    string currentDate = "";
                    var filteredActivities = showMentionedOnly 
                        ? activityData.Where(a => a.Type == "mention").ToList() 
                        : activityData;
                }
                @foreach (var item in filteredActivities)
                {
                    var showDate = currentDate != item.Date;
                    if (showDate)
                    {
                        currentDate = item.Date;
                    }

                    <div class="mb-4">
                        @if (showDate)
                        {
                            <!-- Date Header -->
                            <div class="text-muted small fw-medium mb-3 text-uppercase">
                                @item.Date
                            </div>
                        }

                        <!-- Activity Item -->
                        <div class="d-flex gap-3 position-relative">
                            <!-- Timeline Line -->
                            @if (item.Id != filteredActivities.Last().Id)
                            {
                                <div class="timeline-line"></div>
                            }

                            <!-- Avatar or Icon -->
                            <div class="flex-shrink-0 position-relative" style="z-index: 10;">
                                @if (item.Type == "tag_added" || item.Type == "file_added")
                                {
                                    <div class="activity-icon-wrapper">
                                        @GetActivityIcon(item.Type)
                                    </div>
                                }
                                else
                                {
                                    <div class="activity-avatar">
                                        @if (!string.IsNullOrEmpty(item.User.Avatar))
                                        {
                                            <img src="@item.User.Avatar" alt="@item.User.Name" class="rounded-circle" style="width: 32px; height: 32px; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <div class="avatar-initials">
                                                @item.User.Initials
                                            </div>
                                        }
                                    </div>
                                }
                            </div>

                            <!-- Content -->
                            <div class="flex-grow-1 min-w-0">
                                <div class="d-flex flex-wrap align-items-center gap-2 small">
                                    <div class="d-flex flex-wrap align-items-center gap-2">
                                        <span class="fw-medium">@item.User.Name</span>
                                        <span class="text-muted">@item.Action</span>
                                        @if (!string.IsNullOrEmpty(item.Target))
                                        {
                                            <span class="fw-medium">@item.Target</span>
                                        }
                                        @if (item.Status != null)
                                        {
                                            <span class="text-muted">status to</span>
                                            <span class="badge @GetStatusClass(item.Status.Color)">
                                                <span class="status-dot @GetStatusDotClass(item.Status.Color)"></span>
                                                @item.Status.Text
                                            </span>
                                        }
                                        @if (!string.IsNullOrEmpty(item.Assignee))
                                        {
                                            <span class="text-muted">to</span>
                                            <span class="fw-medium">@item.Assignee</span>
                                        }
                                    </div>
                                    <span class="text-muted ms-auto">@item.Timestamp</span>
                                </div>

                                <!-- Tags -->
                                @if (item.Tags != null && item.Tags.Any())
                                {
                                    <div class="d-flex flex-wrap gap-2 mt-2">
                                        @foreach (var tag in item.Tags)
                                        {
                                            <div class="d-flex align-items-center gap-1">
                                                <span class="tag-dot @GetTagClass(tag.Color)"></span>
                                                <span class="text-muted small">@tag.Text</span>
                                            </div>
                                        }
                                    </div>
                                }

                                <!-- Comment -->
                                @if (!string.IsNullOrEmpty(item.Comment))
                                {
                                    <div class="comment-box mt-2">
                                        @item.Comment
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .activity-timeline {
        max-width: 800px;
    }

    .timeline-line {
        position: absolute;
        left: 16px;
        top: 40px;
        bottom: -20px;
        width: 1px;
        background-color: #dee2e6;
    }

    .activity-icon-wrapper {
        width: 32px;
        height: 32px;
        background-color: #f8f9fa;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .activity-avatar {
        width: 32px;
        height: 32px;
    }

    .avatar-initials {
        width: 32px;
        height: 32px;
        background-color: #0d6efd;
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
        font-weight: 500;
    }

    .status-dot {
        display: inline-block;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        margin-right: 4px;
    }

    .status-dot.green {
        background-color: #198754;
    }

    .status-dot.blue {
        background-color: #0d6efd;
    }

    .status-dot.red {
        background-color: #dc3545;
    }

    .status-dot.orange {
        background-color: #fd7e14;
    }

    .tag-dot {
        display: inline-block;
        width: 6px;
        height: 6px;
        border-radius: 50%;
    }

    .tag-dot.red {
        background-color: #dc3545;
    }

    .tag-dot.blue {
        background-color: #0d6efd;
    }

    .comment-box {
        background-color: #f8f9fa;
        color: #6c757d;
        border-radius: 0.375rem;
        padding: 0.75rem;
        font-size: 0.875rem;
        line-height: 1.5;
    }

    .gap-3 {
        gap: 1rem !important;
    }

    .min-w-0 {
        min-width: 0;
    }
</style>

