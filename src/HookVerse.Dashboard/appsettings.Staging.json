{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.AspNetCore.SignalR": "Information",
      "HookVerse": "Information"
    }
  },
  "AllowedHosts": "*",
  "ApiSettings": {
    "// NOTE": "Dashboard calls API via service discovery or direct URL",
    "// Staging": "Use Container Apps internal service discovery or public URL",
    "// Override": "Set ApiSettings:BaseUrl environment variable",
    "BaseUrl": "https://api-staging.hookverse.com",
    "TimeoutSeconds": 60,
    "RetryCount": 5
  },
  "ConnectionStrings": {
    "// NOTE": "Azure SQL Database connection string for read-only queries",
    "// See": "aspire/templates/key-vault-setup.md for Key Vault configuration",
    "// Format": "Should reference Key Vault secret",
    "// Example": "@Microsoft.KeyVault(SecretUri=https://kv-hookverse-staging.vault.azure.net/secrets/SqlConnectionString/)",
    "AzureSqlDatabase": ""
  },
  "OpenTelemetry": {
    "// NOTE": "OTLP exporter enabled in Staging for observability",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "http://otel-collector:4317",
    "OTEL_RESOURCE_ATTRIBUTES": "service.name=hookverse-dashboard,env=staging"
  },
  "Azure": {
    "KeyVault": {
      "// NOTE": "Key Vault configuration for secret management",
      "Name": "kv-hookverse-staging",
      "VaultUri": "https://kv-hookverse-staging.vault.azure.net/"
    }
  },
  "SignalR": {
    "EnableDetailedErrors": true,
    "KeepAliveIntervalSeconds": 30,
    "ClientTimeoutSeconds": 60
  },
  "Dashboard": {
    "RefreshIntervalSeconds": 10,
    "MaxRecentWebhooks": 500,
    "EnableAutoRefresh": true,
    "PageSize": 50
  },
  "Authentication": {
    "// NOTE": "Staging uses Azure AD or similar authentication",
    "RequireAuthentication": true,
    "AuthenticationScheme": "AzureAd"
  },
  "ApplicationInsights": {
    "// NOTE": "Application Insights for Azure monitoring",
    "ConnectionString": ""
  }
}
