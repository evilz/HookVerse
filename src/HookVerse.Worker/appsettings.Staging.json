{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "HookVerse": "Information",
      "MassTransit": "Information"
    }
  },
  "ConnectionStrings": {
    "// NOTE": "Azure managed service connection strings",
    "// See": "aspire/templates/key-vault-setup.md for Key Vault configuration",
    "// Staging": "Uses Azure SQL Database, Service Bus, Redis Cache",
    "// Format": "Connection strings should reference Key Vault secrets",
    "// Example": "@Microsoft.KeyVault(SecretUri=https://kv-hookverse-staging.vault.azure.net/secrets/SqlConnectionString/)",
    "// Override": "Use environment variables in Container Apps to reference Key Vault",
    "AzureSqlDatabase": "",
    "AzureServiceBus": "",
    "AzureRedisCache": ""
  },
  "OpenTelemetry": {
    "// NOTE": "OTLP exporter enabled in Staging for observability",
    "// Endpoint": "OTel Collector or direct to observability platform",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "http://otel-collector:4317",
    "OTEL_RESOURCE_ATTRIBUTES": "service.name=hookverse-worker,env=staging"
  },
  "Azure": {
    "KeyVault": {
      "// NOTE": "Key Vault configuration for secret management",
      "// Name": "kv-hookverse-staging",
      "// Access": "Managed Identity with 'Key Vault Secrets User' role",
      "Name": "kv-hookverse-staging",
      "VaultUri": "https://kv-hookverse-staging.vault.azure.net/"
    }
  },
  "WorkerSettings": {
    "MaxConcurrentDeliveries": 50,
    "BatchSize": 100,
    "PollingIntervalSeconds": 2,
    "EnableCircuitBreaker": true,
    "CircuitBreakerThreshold": 10,
    "CircuitBreakerDurationSeconds": 120
  },
  "WebhookDelivery": {
    "DefaultTimeoutSeconds": 30,
    "MaxRetries": 5,
    "RetryDelaySeconds": 10,
    "EnablePayloadEncryption": true,
    "ExponentialBackoffMultiplier": 2.0,
    "MaxRetryDelaySeconds": 600
  },
  "Database": {
    "EnableSensitiveDataLogging": false,
    "EnableDetailedErrors": true,
    "CommandTimeout": 60,
    "MaxRetryCount": 5,
    "MaxPoolSize": 100
  },
  "MessageBus": {
    "// NOTE": "Azure Service Bus configuration for staging",
    "PrefetchCount": 20,
    "RetryCount": 5,
    "RetryInterval": 10000,
    "QueueName": "webhook-deliveries",
    "MaxConcurrentCalls": 50,
    "AutoComplete": false
  },
  "ApplicationInsights": {
    "// NOTE": "Application Insights for Azure monitoring",
    "// ConnectionString": "Should be in Key Vault or environment variable",
    "ConnectionString": ""
  }
}
