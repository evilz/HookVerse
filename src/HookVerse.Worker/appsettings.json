{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {},
  "MessageBus": {
    "Transport": "RabbitMQ",
    "ExternalWebhooks": {
      "QueueName": "external-webhooks",
      "ExchangeName": "hookverse.external",
      "ExchangeType": "topic",
      "RoutingKey": "webhook.#",
      "Durable": true,
      "AutoDelete": false,
      "PrefetchCount": 10,
      "DeadLetterQueue": {
        "Enabled": true,
        "QueueName": "external-webhooks-dlq",
        "ExchangeName": "hookverse.external.dlq",
        "MessageTtl": 604800000
      }
    }
  },
  "Redis": {
    "InstanceName": "HookVerse:"
  },
  "DataRetention": {
    "ScheduleIntervalHours": 24,
    "RunAtMidnightUtc": true,
    "BatchSize": 1000
  },
  "GdprProcessing": {
    "PollingIntervalMinutes": 1
  }
}
